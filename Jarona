----------------------------------------------------------------
-- Draggable window
----------------------------------------------------------------

local dragging = false
local dragStart
local startPosition

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart

		main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

----------------------------------------------------------------
-- Utility functions
----------------------------------------------------------------

local function quote(str)
	return string.format("%q", tostring(str))
end

local function num(n)
	return string.format("%.4f", n)
end

local function vector3(v)
	return "Vector3.new("
		.. num(v.X) .. ", "
		.. num(v.Y) .. ", "
		.. num(v.Z) .. ")"
end

local function color3(c)
	return string.format(
		"Color3.fromRGB(%d, %d, %d)",
		math.round(c.R * 255),
		math.round(c.G * 255),
		math.round(c.B * 255)
	)
end

local function cframe(cf)
	local x, y, z,
		r00, r01, r02,
		r10, r11, r12,
		r20, r21, r22 = cf:GetComponents()

	return string.format(
		"CFrame.new(%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)",
		num(x), num(y), num(z),
		num(r00), num(r01), num(r02),
		num(r10), num(r11), num(r12),
		num(r20), num(r21), num(r22)
	)
end

local function materialString(material)
	return "Enum.Material." .. material.Name
end

----------------------------------------------------------------
-- Selected model
----------------------------------------------------------------

local selectedModel

mouse.Button1Down:Connect(function()
	local target = mouse.Target

	if not target then
		return
	end

	local model = target:FindFirstAncestorOfClass("Model")

	if not model then
		if target:IsA("BasePart") then
			model = target
		else
			return
		end
	end

	selectedModel = model

	local parts = 0

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("BasePart") then
			parts += 1
		end
	end

	selectedLabel.Text = "Selected: " .. model.Name
	infoLabel.Text = tostring(parts) .. " BasePart(s) detected"
	status.Text = "Model selected"
	status.TextColor3 = Color3.fromRGB(120, 200, 140)
end)

----------------------------------------------------------------
-- Generate code
----------------------------------------------------------------

local function generateCode(model)

	local lines = {}

	table.insert(lines, "-- Generated model")
	table.insert(lines, "-- Model: " .. model.Name)
	table.insert(lines, "")
	table.insert(lines, "local model = Instance.new(\"Model\")")
	table.insert(lines, "model.Name = " .. quote(model.Name))
	table.insert(lines, "model.Parent = workspace")
	table.insert(lines, "")

	------------------------------------------------------------
	-- Create parts
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do

		if obj:IsA("BasePart") then

			table.insert(lines, "-- Part: " .. obj.Name)
			table.insert(lines, "do")

			table.insert(
				lines,
				"    local part = Instance.new("
					.. quote(obj.ClassName)
					.. ")"
			)

			table.insert(lines, "    part.Name = " .. quote(obj.Name))
			table.insert(lines, "    part.Size = " .. vector3(obj.Size))
			table.insert(lines, "    part.CFrame = " .. cframe(obj.CFrame))
			table.insert(lines, "    part.Color = " .. color3(obj.Color))
			table.insert(lines, "    part.Material = " .. materialString(obj.Material))
			table.insert(lines, "    part.Transparency = " .. num(obj.Transparency))
			table.insert(lines, "    part.Reflectance = " .. num(obj.Reflectance))
			table.insert(lines, "    part.Anchored = " .. tostring(obj.Anchored))
			table.insert(lines, "    part.CanCollide = " .. tostring(obj.CanCollide))
			table.insert(lines, "    part.CanTouch = " .. tostring(obj.CanTouch))
			table.insert(lines, "    part.CanQuery = " .. tostring(obj.CanQuery))
			table.insert(lines, "    part.CastShadow = " .. tostring(obj.CastShadow))

			if obj:IsA("Part") then
				table.insert(
					lines,
					"    part.Shape = Enum.PartType." .. obj.Shape.Name
				)
			end

			if obj:IsA("MeshPart") then
				table.insert(lines, "    part.MeshId = " .. quote(obj.MeshId))
				table.insert(lines, "    part.TextureID = " .. quote(obj.TextureID))
			end

			table.insert(lines, "    part.Parent = model")
			table.insert(lines, "end")
			table.insert(lines, "")
		end
	end

	------------------------------------------------------------
	-- Attachments
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do

		if obj:IsA("Attachment") then

			local parent = obj.Parent

			if parent and parent:IsA("BasePart") then

				table.insert(lines, "-- Attachment: " .. obj.Name)
				table.insert(lines, "do")

				table.insert(
					lines,
					"    local attachment = Instance.new(\"Attachment\")"
				)

				table.insert(lines, "    attachment.Name = " .. quote(obj.Name))
				table.insert(lines, "    attachment.Position = " .. vector3(obj.Position))
				table.insert(lines, "    attachment.Orientation = " .. vector3(obj.Orientation))

				table.insert(
					lines,
					"    attachment.Parent = model:FindFirstChild("
						.. quote(parent.Name)
						.. ", true)"
				)

				table.insert(lines, "end")
				table.insert(lines, "")
			end
		end
	end

	------------------------------------------------------------
	-- Decals
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do

		if obj:IsA("Decal") then

			local parent = obj.Parent

			if parent and parent:IsA("BasePart") then

				table.insert(lines, "-- Decal: " .. obj.Name)
				table.insert(lines, "do")

				table.insert(lines, "    local decal = Instance.new(\"Decal\")")
				table.insert(lines, "    decal.Name = " .. quote(obj.Name))
				table.insert(lines, "    decal.Texture = " .. quote(obj.Texture))
				table.insert(lines, "    decal.Transparency = " .. num(obj.Transparency))
				table.insert(lines, "    decal.Face = Enum.NormalId." .. obj.Face.Name)

				table.insert(
					lines,
					"    decal.Parent = model:FindFirstChild("
						.. quote(parent.Name)
						.. ", true)"
				)

				table.insert(lines, "end")
				table.insert(lines, "")
			end
		end
	end

	------------------------------------------------------------
	-- Textures
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do

		if obj:IsA("Texture") then

			local parent = obj.Parent

			if parent and parent:IsA("BasePart") then

				table.insert(lines, "-- Texture: " .. obj.Name)
				table.insert(lines, "do")

				table.insert(lines, "    local texture = Instance.new(\"Texture\")")
				table.insert(lines, "    texture.Name = " .. quote(obj.Name))
				table.insert(lines, "    texture.Texture = " .. quote(obj.Texture))
				table.insert(lines, "    texture.Transparency = " .. num(obj.Transparency))
				table.insert(lines, "    texture.Face = Enum.NormalId." .. obj.Face.Name)
				table.insert(lines, "    texture.StudsPerTileU = " .. num(obj.StudsPerTileU))
				table.insert(lines, "    texture.StudsPerTileV = " .. num(obj.StudsPerTileV))

				table.insert(
					lines,
					"    texture.Parent = model:FindFirstChild("
						.. quote(parent.Name)
						.. ", true)"
				)

				table.insert(lines, "end")
				table.insert(lines, "")
			end
		end
	end

	------------------------------------------------------------
	-- SurfaceAppearance
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do

		if obj:IsA("SurfaceAppearance") then

			local parent = obj.Parent

			if parent then

				table.insert(lines, "-- SurfaceAppearance")
				table.insert(lines, "do")

				table.insert(
					lines,
					"    local surface = Instance.new(\"SurfaceAppearance\")"
				)

				table.insert(lines, "    surface.AlphaMode = Enum.AlphaMode." .. obj.AlphaMode.Name)
				table.insert(lines, "    surface.ColorMap = " .. quote(obj.ColorMap))
				table.insert(lines, "    surface.MetalnessMap = " .. quote(obj.MetalnessMap))
				table.insert(lines, "    surface.NormalMap = " .. quote(obj.NormalMap))
				table.insert(lines, "    surface.RoughnessMap = " .. quote(obj.RoughnessMap))

				table.insert(
					lines,
					"    surface.Parent = model:FindFirstChild("
						.. quote(parent.Name)
						.. ", true)"
				)

				table.insert(lines, "end")
				table.insert(lines, "")
			end
		end
	end

	------------------------------------------------------------
	-- WeldConstraints
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do

		if obj:IsA("WeldConstraint") then

			table.insert(lines, "-- WeldConstraint: " .. obj.Name)
			table.insert(lines, "do")

			table.insert(lines, "    local weld = Instance.new(\"WeldConstraint\")")
			table.insert(lines, "    weld.Name = " .. quote(obj.Name))

			if obj.Part0 then
				table.insert(
					lines,
					"    weld.Part0 = model:FindFirstChild("
						.. quote(obj.Part0.Name)
						.. ", true)"
				)
			end

			if obj.Part1 then
				table.insert(
					lines,
					"    weld.Part1 = model:FindFirstChild("
						.. quote(obj.Part1.Name)
						.. ", true)"
				)
			end

			table.insert(lines, "    weld.Parent = model")
			table.insert(lines, "end")
			table.insert(lines, "")
		end
	end

	------------------------------------------------------------
	-- Weld objects
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do

		if obj:IsA("Weld") or obj:IsA("ManualWeld") then

			table.insert(lines, "-- Weld: " .. obj.Name)
			table.insert(lines, "do")

			table.insert(
				lines,
				"    local weld = Instance.new("
					.. quote(obj.ClassName)
					.. ")"
			)

			table.insert(lines, "    weld.Name = " .. quote(obj.Name))

			if obj.Part0 then
				table.insert(
					lines,
					"    weld.Part0 = model:FindFirstChild("
						.. quote(obj.Part0.Name)
						.. ", true)"
				)
			end

			if obj.Part1 then
				table.insert(
					lines,
					"    weld.Part1 = model:FindFirstChild("
						.. quote(obj.Part1.Name)
						.. ", true)"
				)
			end

			table.insert(lines, "    weld.C0 = " .. cframe(obj.C0))
			table.insert(lines, "    weld.C1 = " .. cframe(obj.C1))
			table.insert(lines, "    weld.Parent = model")

			table.insert(lines, "end")
			table.insert(lines, "")
		end
	end

	table.insert(lines, "-- End generated code")

	return table.concat(lines, "\n")
end

