generate.Activated:Connect(function()

	if not selectedModel then
		status.Text = "Select a model first."
		status.TextColor3 = Color3.fromRGB(230, 130, 100)
		return
	end

	status.Text = "Generating..."
	status.TextColor3 = Color3.fromRGB(230, 200, 100)

	task.wait()

	codeBox.Text = generateCode(selectedModel)

	status.Text = "Code generated successfully."
	status.TextColor3 = Color3.fromRGB(120, 220, 150)
end)

clear.Activated:Connect(function()
	codeBox.Text = "-- Generated Lua will appear here"
	status.Text = "Cleared"
end)

