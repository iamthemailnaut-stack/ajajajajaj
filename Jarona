local function generateSpawnCode(model)
	local lines = {}

	table.insert(lines, "-- Exact model recreation")
	table.insert(lines, "-- Original model: " .. string.format("%q", model.Name))
	table.insert(lines, "")
	table.insert(lines, "local model = Instance.new(\"Model\")")
	table.insert(lines, "model.Name = " .. string.format("%q", model.Name))
	table.insert(lines, "model.Parent = workspace")
	table.insert(lines, "")

	local function n(v)
		return string.format("%.6f", v)
	end

	local function vec3(v)
		return string.format(
			"Vector3.new(%s, %s, %s)",
			n(v.X), n(v.Y), n(v.Z)
		)
	end

	local function cf(v)
		local x, y, z,
			r00, r01, r02,
			r10, r11, r12,
			r20, r21, r22 = v:GetComponents()

		return string.format(
			"CFrame.new(%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)",
			n(x), n(y), n(z),
			n(r00), n(r01), n(r02),
			n(r10), n(r11), n(r12),
			n(r20), n(r21), n(r22)
		)
	end

	local function color(c)
		return string.format(
			"Color3.fromRGB(%d, %d, %d)",
			math.round(c.R * 255),
			math.round(c.G * 255),
			math.round(c.B * 255)
		)
	end

	------------------------------------------------------------
	-- Parts
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("BasePart") then

			table.insert(lines, "do")
			table.insert(
				lines,
				"    local part = Instance.new("
					.. string.format("%q", obj.ClassName)
					.. ")"
			)

			table.insert(lines, "    part.Name = " .. string.format("%q", obj.Name))

			-- Exact world properties
			table.insert(lines, "    part.CFrame = " .. cf(obj.CFrame))
			table.insert(lines, "    part.Size = " .. vec3(obj.Size))

			table.insert(lines, "    part.Color = " .. color(obj.Color))
			table.insert(lines, "    part.Material = Enum.Material." .. obj.Material.Name)

			table.insert(lines, "    part.Transparency = " .. n(obj.Transparency))
			table.insert(lines, "    part.Reflectance = " .. n(obj.Reflectance))

			table.insert(lines, "    part.Anchored = " .. tostring(obj.Anchored))
			table.insert(lines, "    part.CanCollide = " .. tostring(obj.CanCollide))
			table.insert(lines, "    part.CanTouch = " .. tostring(obj.CanTouch))
			table.insert(lines, "    part.CanQuery = " .. tostring(obj.CanQuery))
			table.insert(lines, "    part.CastShadow = " .. tostring(obj.CastShadow))

			if obj:IsA("Part") then
				table.insert(
					lines,
					"    part.Shape = Enum.PartType." .. obj.Shape.Name
				)
			end

			if obj:IsA("MeshPart") then
				table.insert(lines, "    part.MeshId = " .. string.format("%q", obj.MeshId))
				table.insert(lines, "    part.TextureID = " .. string.format("%q", obj.TextureID))
			end

			table.insert(lines, "    part.Parent = model")
			table.insert(lines, "end")
			table.insert(lines, "")
		end
	end

	------------------------------------------------------------
	-- Decals
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("Decal") and obj.Parent then

			table.insert(lines, "do")
			table.insert(lines, "    local decal = Instance.new(\"Decal\")")
			table.insert(lines, "    decal.Name = " .. string.format("%q", obj.Name))
			table.insert(lines, "    decal.Texture = " .. string.format("%q", obj.Texture))
			table.insert(lines, "    decal.Transparency = " .. n(obj.Transparency))
			table.insert(lines, "    decal.Face = Enum.NormalId." .. obj.Face.Name)

			table.insert(
				lines,
				"    decal.Parent = model:FindFirstChild("
					.. string.format("%q", obj.Parent.Name)
					.. ", true)"
			)

			table.insert(lines, "end")
			table.insert(lines, "")
		end
	end

	------------------------------------------------------------
	-- Textures
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("Texture") and obj.Parent then

			table.insert(lines, "do")
			table.insert(lines, "    local texture = Instance.new(\"Texture\")")
			table.insert(lines, "    texture.Name = " .. string.format("%q", obj.Name))
			table.insert(lines, "    texture.Texture = " .. string.format("%q", obj.Texture))
			table.insert(lines, "    texture.Transparency = " .. n(obj.Transparency))
			table.insert(lines, "    texture.Face = Enum.NormalId." .. obj.Face.Name)
			table.insert(lines, "    texture.StudsPerTileU = " .. n(obj.StudsPerTileU))
			table.insert(lines, "    texture.StudsPerTileV = " .. n(obj.StudsPerTileV))

			table.insert(
				lines,
				"    texture.Parent = model:FindFirstChild("
					.. string.format("%q", obj.Parent.Name)
					.. ", true)"
			)

			table.insert(lines, "end")
			table.insert(lines, "")
		end
	end

	------------------------------------------------------------
	-- Attachments
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("Attachment") and obj.Parent then

			table.insert(lines, "do")
			table.insert(lines, "    local attachment = Instance.new(\"Attachment\")")
			table.insert(lines, "    attachment.Name = " .. string.format("%q", obj.Name))
			table.insert(lines, "    attachment.CFrame = " .. cf(obj.CFrame))

			table.insert(
				lines,
				"    attachment.Parent = model:FindFirstChild("
					.. string.format("%q", obj.Parent.Name)
					.. ", true)"
			)

			table.insert(lines, "end")
			table.insert(lines, "")
		end
	end

	------------------------------------------------------------
	-- WeldConstraints
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("WeldConstraint") then

			table.insert(lines, "do")
			table.insert(lines, "    local weld = Instance.new(\"WeldConstraint\")")
			table.insert(lines, "    weld.Name = " .. string.format("%q", obj.Name))

			if obj.Part0 then
				table.insert(
					lines,
					"    weld.Part0 = model:FindFirstChild("
						.. string.format("%q", obj.Part0.Name)
						.. ", true)"
				)
			end

			if obj.Part1 then
				table.insert(
					lines,
					"    weld.Part1 = model:FindFirstChild("
						.. string.format("%q", obj.Part1.Name)
						.. ", true)"
				)
			end

			table.insert(lines, "    weld.Parent = model")
			table.insert(lines, "end")
			table.insert(lines, "")
		end
	end

	------------------------------------------------------------
	-- Weld / ManualWeld
	------------------------------------------------------------

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("Weld") or obj:IsA("ManualWeld") then

			table.insert(lines, "do")
			table.insert(
				lines,
				"    local weld = Instance.new("
					.. string.format("%q", obj.ClassName)
					.. ")"
			)

			table.insert(lines, "    weld.Name = " .. string.format("%q", obj.Name))

			if obj.Part0 then
				table.insert(
					lines,
					"    weld.Part0 = model:FindFirstChild("
						.. string.format("%q", obj.Part0.Name)
						.. ", true)"
				)
			end

			if obj.Part1 then
				table.insert(
					lines,
					"    weld.Part1 = model:FindFirstChild("
						.. string.format("%q", obj.Part1.Name)
						.. ", true)"
				)
			end

			table.insert(lines, "    weld.C0 = " .. cf(obj.C0))
			table.insert(lines, "    weld.C1 = " .. cf(obj.C1))
			table.insert(lines, "    weld.Parent = model")

			table.insert(lines, "end")
			table.insert(lines, "")
		end
	end

	table.insert(lines, "return model")

	return table.concat(lines, "\n")
end
