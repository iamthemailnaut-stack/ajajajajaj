generateButton.Activated:Connect(function()

	if not selectedModel then

		status.Text =
			"Click a model first."

		return

	end

	status.Text =
		"Generating..."

	task.wait()

	local success, result =
		pcall(function()

			return generate(selectedModel)

		end)

	if success then

		codeBox.Text = result

		status.Text =
			"Lua generated."

	else

		codeBox.Text =
			"-- ERROR\n"
			.. tostring(result)

		status.Text =
			"Generation failed."

	end

end)

