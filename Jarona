--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function q(v)
	return string.format("%q", tostring(v))
end

local function n(v)
	return string.format("%.5f", v)
end

local function vector(v)
	return string.format(
		"Vector3.new(%s,%s,%s)",
		n(v.X), n(v.Y), n(v.Z)
	)
end

local function cframe(v)
	local x,y,z,
		r00,r01,r02,
		r10,r11,r12,
		r20,r21,r22 = v:GetComponents()

	return string.format(
		"CFrame.new(%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)",
		n(x), n(y), n(z),
		n(r00), n(r01), n(r02),
		n(r10), n(r11), n(r12),
		n(r20), n(r21), n(r22)
	)
end

local function color(v)
	return string.format(
		"Color3.fromRGB(%d,%d,%d)",
		math.round(v.R * 255),
		math.round(v.G * 255),
		math.round(v.B * 255)
	)
end

--------------------------------------------------
-- COLLECT
--------------------------------------------------

local function collect(root)

	local result = {}

	if root ~= workspace then
		table.insert(result, root)
	end

	for _, obj in ipairs(root:GetDescendants()) do

		if skipUnions and obj:IsA("UnionOperation") then
			continue
		end

		if obj:IsA("Decal") or obj:IsA("Texture") then
			if decals then
				table.insert(result, obj)
			end

		elseif obj:IsA("Weld")
			or obj:IsA("ManualWeld")
			or obj:IsA("WeldConstraint") then

			if welds then
				table.insert(result, obj)
			end

		elseif obj:IsA("Model")
			or obj:IsA("Folder")
			or obj:IsA("BasePart")
			or obj:IsA("Attachment")
			or obj:IsA("SurfaceAppearance") then

			table.insert(result, obj)
		end

	end

	return result
end

--------------------------------------------------
-- GENERATOR
--------------------------------------------------

local function generate(root)

	local objects = collect(root)

	if #objects > 10000 then
		return "-- Too many objects. Generation stopped."
	end

	local ids = {}

	for i, obj in ipairs(objects) do
		ids[obj] = "i" .. i
	end

	local out = {}

	table.insert(out, "-- Generated Lua")
	table.insert(out, "-- Source: " .. root:GetFullName())
	table.insert(out, "")
	table.insert(out, "local i = {}")
	table.insert(out, "")

	--------------------------------------------------
	-- CREATE
	--------------------------------------------------

	for _, obj in ipairs(objects) do

		local id = ids[obj]

		table.insert(
			out,
			"i." .. id ..
			" = Instance.new(" ..
			q(obj.ClassName) ..
			")"
		)

		table.insert(
			out,
			"i." .. id ..
			".Name = " ..
			q(obj.Name)
		)
	end

	table.insert(out, "")

	--------------------------------------------------
	-- PROPERTIES
	--------------------------------------------------

	for _, obj in ipairs(objects) do

		local id = ids[obj]

		if obj:IsA("BasePart") then

			table.insert(
				out,
				"i." .. id ..
				".CFrame = " ..
				cframe(obj.CFrame)
			)

			table.insert(
				out,
				"i." .. id ..
				".Size = " ..
				vector(obj.Size)
			)

			table.insert(
				out,
				"i." .. id ..
				".Color = " ..
				color(obj.Color)
			)

			table.insert(
				out,
				"i." .. id ..
				".Material = Enum.Material." ..
				obj.Material.Name
			)

			table.insert(
				out,
				"i." .. id ..
				".Transparency = " ..
				n(obj.Transparency)
			)

			table.insert(
				out,
				"i." .. id ..
				".Anchored = " ..
				tostring(obj.Anchored)
			)

			table.insert(
				out,
				"i." .. id ..
				".CanCollide = " ..
				tostring(obj.CanCollide)
			)

			table.insert(
				out,
				"i." .. id ..
				".CanTouch = " ..
				tostring(obj.CanTouch)
			)

			table.insert(
				out,
				"i." .. id ..
				".CanQuery = " ..
				tostring(obj.CanQuery)
			)

			if obj:IsA("MeshPart") then

				table.insert(
					out,
					"i." .. id ..
					".MeshId = " ..
					q(obj.MeshId)
				)

				table.insert(
					out,
					"i." .. id ..
					".TextureID = " ..
					q(obj.TextureID)
				)

			elseif obj:IsA("Part") then

				table.insert(
					out,
					"i." .. id ..
					".Shape = Enum.PartType." ..
					obj.Shape.Name
				)

			end

		elseif obj:IsA("Decal")
			or obj:IsA("Texture") then

			table.insert(
				out,
				"i." .. id ..
				".Texture = " ..
				q(obj.Texture)
			)

			table.insert(
				out,
				"i." .. id ..
				".Face = Enum.NormalId." ..
				obj.Face.Name
			)

		elseif obj:IsA("Attachment") then

			table.insert(
				out,
				"i." .. id ..
				".CFrame = " ..
				cframe(obj.CFrame)
			)

		elseif obj:IsA("SurfaceAppearance") then

			table.insert(
				out,
				"i." .. id ..
				".ColorMap = " ..
				q(obj.ColorMap)
			)

			table.insert(
				out,
				"i." .. id ..
				".NormalMap = " ..
				q(obj.NormalMap)
			)

		elseif obj:IsA("WeldConstraint") then

			if ids[obj.Part0] then
				table.insert(
					out,
					"i." .. id ..
					".Part0 = i." ..
					ids[obj.Part0]
				)
			end

			if ids[obj.Part1] then
				table.insert(
					out,
					"i." .. id ..
					".Part1 = i." ..
					ids[obj.Part1]
				)
			end

		elseif obj:IsA("Weld")
			or obj:IsA("ManualWeld") then

			if ids[obj.Part0] then
				table.insert(
					out,
					"i." .. id ..
					".Part0 = i." ..
					ids[obj.Part0]
				)
			end

			if ids[obj.Part1] then
				table.insert(
					out,
					"i." .. id ..
					".Part1 = i." ..
					ids[obj.Part1]
				)
			end

			table.insert(
				out,
				"i." .. id ..
				".C0 = " ..
				cframe(obj.C0)
			)

			table.insert(
				out,
				"i." .. id ..
				".C1 = " ..
				cframe(obj.C1)
			)
		end
	end

	--------------------------------------------------
	-- PARENTS
	--------------------------------------------------

	for _, obj in ipairs(objects) do

		local id = ids[obj]

		if obj == root then

			table.insert(
				out,
				"i." .. id ..
				".Parent = workspace"
			)

		else

			local parent = obj.Parent

			if parent and ids[parent] then

				table.insert(
					out,
					"i." .. id ..
					".Parent = i." ..
					ids[parent]
				)

			end
		end
	end

	table.insert(out, "")
	table.insert(out, "return i." .. ids[root])

	return table.concat(out, "\n")
end

--------------------------------------------------
-- TARGET
--------------------------------------------------

local function getTarget()

	local target = mouse.Target

	if not target then
		return nil
	end

	local model =
		target:FindFirstAncestorOfClass("Model")

	return model or target
end

--------------------------------------------------
-- GENERATE
--------------------------------------------------

local function doGenerate(root)

	if not root then

		status.Text =
			"Nothing selected."

		return
	end

	status.Text = "Generating..."

	task.wait()

	local success, result =
		pcall(function()
			return generate(root)
		end)

	if success then

		code.Text = result

		status.Text =
			"Generated successfully."

	else

		code.Text =
			"-- ERROR\n\n" ..
			tostring(result)

		status.Text =
			"Generation failed."
	end
end

--------------------------------------------------
-- BUTTONS
--------------------------------------------------

selectedButton.Activated:Connect(function()

	doGenerate(getTarget())

end)

modelsButton.Activated:Connect(function()

	doGenerate(workspace)

end)

partsButton.Activated:Connect(function()

	local folder = Instance.new("Folder")
	folder.Name = "PartsForGeneration"

	for _, obj in ipairs(workspace:GetDescendants()) do

		if obj:IsA("BasePart") then

			-- Only create references for generation;
			-- don't clone or parent anything.
			local marker = Instance.new("ObjectValue")
			marker.Name = obj.Name
			marker.Value = obj
			marker.Parent = folder

		end
	end

	-- Generate directly from Workspace instead of
	-- attempting to copy/parent parts.
	local success, result =
		pcall(function()
			return generate(workspace)
		end)

	folder:Destroy()

	if success then
		code.Text = result
		status.Text = "Parts/workspace generated."
	else
		code.Text = "-- ERROR\n\n" .. tostring(result)
		status.Text = "Generation failed."
	end

end)

workspaceButton.Activated:Connect(function()

	doGenerate(workspace)

end)

clearButton.Activated:Connect(function()

	code.Text = ""
	status.Text = "Cleared."

end)

copyButton.Activated:Connect(function()

	-- Roblox does not expose arbitrary clipboard
