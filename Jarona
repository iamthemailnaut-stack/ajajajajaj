local selectedModel

mouse.Button1Down:Connect(function()

	local target = mouse.Target

	if not target then
		return
	end

	local model =
		target:FindFirstAncestorOfClass("Model")

	if not model then

		if target:IsA("BasePart") then
			selectedModel = target
		else
			return
		end

	else

		selectedModel = model

	end

	selectionLabel.Text =
		"Selected: " .. selectedModel.Name

	status.Text =
		"Selection ready."

end)

------------------------------------------------------------
-- HELPERS
------------------------------------------------------------

local function q(v)

	return string.format("%q", tostring(v))

end

local function n(v)

	return string.format("%.6f", v)

end

local function vector(v)

	return string.format(
		"Vector3.new(%s,%s,%s)",
		n(v.X),
		n(v.Y),
		n(v.Z)
	)

end

local function color(v)

	return string.format(
		"Color3.fromRGB(%d,%d,%d)",
		math.round(v.R * 255),
		math.round(v.G * 255),
		math.round(v.B * 255)
	)

end

local function cframe(v)

	local x,y,z,
		r00,r01,r02,
		r10,r11,r12,
		r20,r21,r22 =
		v:GetComponents()

	return string.format(
		"CFrame.new(%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)",
		n(x),n(y),n(z),
		n(r00),n(r01),n(r02),
		n(r10),n(r11),n(r12),
		n(r20),n(r21),n(r22)
	)

end

------------------------------------------------------------
-- GENERATE
------------------------------------------------------------

local function generate(root)

	local objects = {root}

	for _, obj in ipairs(root:GetDescendants()) do
		table.insert(objects, obj)
	end

	local ids = {}

	for index, obj in ipairs(objects) do
		ids[obj] = "i" .. index
	end

	local lines = {}

	table.insert(lines, "-- Generated model")
	table.insert(lines, "-- Original: " .. root.Name)
	table.insert(lines, "")
	table.insert(lines, "local i = {}")
	table.insert(lines, "")

	----------------------------------------------------------
	-- CREATE
	----------------------------------------------------------

	for _, obj in ipairs(objects) do

		if obj:IsA("UnionOperation") and skipUnions then
			continue
		end

		local id = ids[obj]

		local supported =
			obj:IsA("Model")
			or obj:IsA("Folder")
			or obj:IsA("BasePart")
			or obj:IsA("Attachment")
			or obj:IsA("Decal")
			or obj:IsA("Texture")
			or obj:IsA("SurfaceAppearance")
			or obj:IsA("Weld")
			or obj:IsA("ManualWeld")
			or obj:IsA("WeldConstraint")

		if supported then

			table.insert(
				lines,
				"i." .. id
				.. " = Instance.new("
				.. q(obj.ClassName)
				.. ")"
			)

			table.insert(
				lines,
				"i." .. id
				.. ".Name = "
				.. q(obj.Name)
			)

		end

	end

	table.insert(lines, "")

	----------------------------------------------------------
	-- PROPERTIES
	----------------------------------------------------------

	for _, obj in ipairs(objects) do

		if obj:IsA("UnionOperation") and skipUnions then
			continue
		end

		local id = ids[obj]

		if obj:IsA("BasePart") then

			table.insert(
				lines,
				"i." .. id
				.. ".CFrame = "
				.. cframe(obj.CFrame)
			)

			table.insert(
				lines,
				"i." .. id
				.. ".Size = "
				.. vector(obj.Size)
			)

			table.insert(
				lines,
				"i." .. id
				.. ".Color = "
				.. color(obj.Color)
			)

			table.insert(
				lines,
				"i." .. id
				.. ".Material = Enum.Material."
				.. obj.Material.Name
			)

			table.insert(
				lines,
				"i." .. id
				.. ".Transparency = "
				.. n(obj.Transparency)
			)

			table.insert(
				lines,
				"i." .. id
				.. ".Reflectance = "
				.. n(obj.Reflectance)
			)

			table.insert(
				lines,
				"i." .. id
				.. ".Anchored = "
				.. tostring(obj.Anchored)
			)

			table.insert(
				lines,
				"i." .. id
				.. ".CanCollide = "
				.. tostring(obj.CanCollide)
			)

			table.insert(
				lines,
				"i." .. id
				.. ".CanTouch = "
				.. tostring(obj.CanTouch)
			)

			table.insert(
				lines,
				"i." .. id
				.. ".CanQuery = "
				.. tostring(obj.CanQuery)
			)

			if obj:IsA("MeshPart") then

				table.insert(
					lines,
					"i." .. id
					.. ".MeshId = "
					.. q(obj.MeshId)
				)

				table.insert(
					lines,
					"i." .. id
					.. ".TextureID = "
					.. q(obj.TextureID)
				)

			end

			if obj:IsA("Part") then

				table.insert(
					lines,
					"i." .. id
					.. ".Shape = Enum.PartType."
					.. obj.Shape.Name
				)

			end

		elseif obj:IsA("Decal") then

			table.insert(
				lines,
				"i." .. id
				.. ".Texture = "
				.. q(obj.Texture)
			)

			table.insert(
				lines,
				"i." .. id
				.. ".Face = Enum.NormalId."
				.. obj.Face.Name
			)

		elseif obj:IsA("Texture") then

			table.insert(
				lines,
				"i." .. id
				.. ".Texture = "
				.. q(obj.Texture)
			)

			table.insert(
				lines,
				"i." .. id
				.. ".Face = Enum.NormalId."
				.. obj.Face.Name
			)

		elseif obj:IsA("Attachment") then

			table.insert(
				lines,
				"i." .. id
				.. ".CFrame = "
				.. cframe(obj.CFrame)
			)

		elseif obj:IsA("WeldConstraint") then

			if obj.Part0
				and ids[obj.Part0] then

				table.insert(
					lines,
					"i." .. id
					.. ".Part0 = i."
					.. ids[obj.Part0]
				)

			end

			if obj.Part1
				and ids[obj.Part1] then

				table.insert(
					lines,
					"i." .. id
					.. ".Part1 = i."
					.. ids[obj.Part1]
				)

			end

		elseif obj:IsA("Weld")
			or obj:IsA("ManualWeld") then

			if obj.Part0
				and ids[obj.Part0] then

				table.insert(
					lines,
					"i." .. id
					.. ".Part0 = i."
					.. ids[obj.Part0]
				)

			end

			if obj.Part1
				and ids[obj.Part1] then

				table.insert(
					lines,
					"i." .. id
					.. ".Part1 = i."
					.. ids[obj.Part1]
				)

			end

			table.insert(
				lines,
				"i." .. id
				.. ".C0 = "
				.. cframe(obj.C0)
			)

			table.insert(
				lines,
				"i." .. id
				.. ".C1 = "
				.. cframe(obj.C1)
			)

		end

	end

	----------------------------------------------------------
	-- PARENT
	----------------------------------------------------------

	for _, obj in ipairs(objects) do

		if obj:IsA("UnionOperation") and skipUnions then
			continue
		end

		local id = ids[obj]

		if obj == root then

			table.insert(
				lines,
				"i." .. id
				.. ".Parent = workspace"
			)

		else

			local parent = obj.Parent

			if parent and ids[parent] then

				table.insert(
					lines,
					"i." .. id
					.. ".Parent = i."
					.. ids[parent]
				)

			end

		end

	end

	table.insert(lines, "")
	table.insert(
		lines,
		"return i." .. ids[root]
	)

	return table.concat(lines, "\n")

end

