------------------------------------------------------------
-- COPY WORKSPACE MODELS
------------------------------------------------------------

workspaceModels.Activated:Connect(function()

	local folder = Instance.new("Folder")

	folder.Name =
		"Workspace_Models_Copy"

	local count = 0

	for _, obj in ipairs(workspace:GetChildren()) do

		if obj:IsA("Model") then

			local clone = obj:Clone()

			clone.Parent = folder

			count += 1

		end

	end

	if count == 0 then

		folder:Destroy()

		status.Text =
			"No models found."

		return

	end

	folder.Parent = workspace

	status.Text =
		"Copied "
		.. count
		.. " models."

end)

