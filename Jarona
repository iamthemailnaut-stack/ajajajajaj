------------------------------------------------------------
-- COPY ENTIRE WORKSPACE
------------------------------------------------------------

copyWorkspace.Activated:Connect(function()

	status.Text =
		"Scanning Workspace..."

	local objects = workspace:GetDescendants()

	local count = #objects

	-- Safety limit to avoid accidentally freezing the client.
	if count > 3000 then

		status.Text =
			"Workspace too large: "
			.. count
			.. " objects."

		warn(
			"Workspace copy cancelled because it contains "
			.. count
			.. " objects."
		)

		return

	end

	local folder = Instance.new("Folder")

	folder.Name =
		"Workspace_Copy"

	local copied = 0

	for _, obj in ipairs(workspace:GetChildren()) do

		local success, clone =
			pcall(function()

				return obj:Clone()

			end)

		if success and clone then

			clone.Parent = folder

			copied += 1

		end

	end

	folder.Parent = workspace

	status.Text =
		"Workspace copied: "
		.. copied
		.. " top-level objects."

end)
